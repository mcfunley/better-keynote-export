<!DOCTYPE html>
<html>
  <head>
    <title>{{ title if title != None else 'Title' }}</title>
    <link rel="stylesheet" href="presentation.css">
    {%- if favicon %}
    <link rel="icon" href="favicon.ico" sizes="32x32">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link rel="manifest" href="site.webmanifest">
    {%- endif %}
    <meta charset="utf-8">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, height=device-height, initial-scale=1" name="viewport">
    {%- if description %}
    <meta name="description" content="{{ description|e }}">
    {%- endif %}
    {%- if page_url %}
    <link rel="canonical" href="{{ page_url|e }}">
    {%- endif %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title|e if title != None else 'Title' }}">
    {%- if description %}
    <meta property="og:description" content="{{ description|e }}">
    {%- endif %}
    {%- if page_url %}
    <meta property="og:url" content="{{ page_url|e }}">
    {%- endif %}
    {%- if share_url %}
    <meta property="og:image" content="{{ share_url|e }}">
    <meta property="og:image:width" content="{{ share_width }}">
    <meta property="og:image:height" content="{{ share_height }}">
    <meta property="og:image:alt" content="{{ title|e if title != None else 'Title' }}">
    {%- endif %}
    <meta name="twitter:card" content="{{ 'summary_large_image' if share_url else 'summary' }}">
  </head>
  <body>

    {% if header_link_url %}
    <nav class="header-link">
      <a href="{{ header_link_url }}">{{ header_link_text }}</a>
    </nav>
    {% endif %}

    <header>
      <h1>{{ title if title != None else 'Title' }}</h1>
      {% if abstract %}<div class="prose">{{ abstract }}</div>{% endif %}

      {% include "share.jinja" %}
    </header>

    <div class="presentation">
      <ol class="slides">
        {% for s in slides %}
          <li class="slide" id="{{ loop.index }}">
            <a class="slide-index" href="#{{ loop.index }}">{{ loop.index }}</a>
            <div class="slide-image">
              <img src="{{ s['src'] }}"
                   srcset="{{ s['srcset'] }}"
                   sizes="{{ sizes }}"
                   width="{{ s['width'] }}"
                   height="{{ s['height'] }}"
                   loading="{{ 'eager' if loop.first else 'lazy' }}"
                   decoding="async"
                   alt="Slide {{ loop.index }}" />
            </div>
            <div class="slide-note">
              {% for p in s['paragraphs'] %}<p>{{ p }}</p>{% endfor %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>

    <footer>
      {% include "share.jinja" %}

      {% if footer %}<div class="prose">{{ footer }}</div>{% endif %}

      <p class="colophon">
        Generated with
        <a href="https://github.com/mcfunley/better-keynote-export">
          keynote-export</a>.
      </p>
    </footer>
  </body>
</html>
